# Copy to .env and fill in the key for the provider you will use.
# The `primocut doctor` command validates the key of the selected provider.

# Analysis provider: anthropic (default), openai or openrouter
# PRIMOCUT_LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
# PRIMOCUT_ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI ---
OPENAI_API_KEY=
# PRIMOCUT_OPENAI_MODEL=gpt-4o

# --- OpenRouter (OpenAI-compatible; access many models with 1 key) ---
OPENROUTER_API_KEY=
# PRIMOCUT_OPENROUTER_MODEL=openai/gpt-4o-mini
# PRIMOCUT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Competitor modeling (Phase 2): YouTube Data API v3 (public data only) ---
# Required for projects/competitor commands. Free tier: 10,000 units/day.
PRIMOCUT_YOUTUBE_API_KEY=
# PRIMOCUT_YOUTUBE_SHORT_MAX_SECONDS=60
# PRIMOCUT_YOUTUBE_BACKFILL_LIMIT=120
# PRIMOCUT_YOUTUBE_RECENT_DAYS=7            # a video is "recent" (6h pass) for this many days
# PRIMOCUT_YOUTUBE_UPLOADS_SCAN_LIMIT=15    # top-of-uploads window for new-video detection
# PRIMOCUT_YOUTUBE_COMMENT_PAGES=2          # pages of top comments collected per outlier (1 unit/page of 100)
# Snapshot cron schedules (daily hour offset from the 6h grid to avoid same-tick runs):
# PRIMOCUT_SNAPSHOT_DAILY_CRON=0 3 * * *
# PRIMOCUT_SNAPSHOT_RECENT_CRON=0 */6 * * *

# --- Competitor modeling (Phase 2): metrics engine (computed on read) ---
# Outlier score = latest views / channel median baseline (per format). Baseline
# window = the smaller of "last N videos" and "last D days"; min sample before a
# score is emitted; a video younger than the provisional cutoff is flagged.
# PRIMOCUT_OUTLIER_WINDOW_VIDEOS=50
# PRIMOCUT_OUTLIER_WINDOW_DAYS=180
# PRIMOCUT_OUTLIER_MIN_SAMPLE=10
# PRIMOCUT_OUTLIER_PROVISIONAL_DAYS=7
# PRIMOCUT_OUTLIER_BRACKETS=3,6,10          # ascending multiplier tiers
# PRIMOCUT_VPH_CURRENT_WINDOW_HOURS=24      # "current" VPH = delta over this window
# Resurgence: old video whose current VPH >= k× its recent trailing-average VPH.
# PRIMOCUT_RESURGENCE_MIN_AGE_DAYS=30
# PRIMOCUT_RESURGENCE_K=3.0
# PRIMOCUT_RESURGENCE_BASELINE_DAYS=7
# PRIMOCUT_RESURGENCE_MIN_VPH=1.0
# PRIMOCUT_PACKAGING_IMPACT_WINDOW_DAYS=7   # mean VPH this many days before/after a change
# Per-project pattern distributions: guard + the bracket that counts as an outlier.
# PRIMOCUT_PATTERN_MIN_OCCURRENCE=15
# PRIMOCUT_PATTERN_OUTLIER_BRACKET=3.0

# --- Phase 2: AI packaging enrichment (opt-in — costs an LLM call) ---
# Empty (the default) means "use the model configured for the selected provider".
# Set one to spend less on a pass. A model id is provider-specific, so an override
# is only valid for the provider in use; the vision model must accept images.
# PRIMOCUT_ENRICH_TITLE_MODEL=claude-haiku-4-5
# PRIMOCUT_ENRICH_VISION_MODEL=claude-sonnet-5
# PRIMOCUT_ENRICH_COMMENTS_MODEL=claude-haiku-4-5

# --- Transcription (optional, have defaults in config.py) ---
# PRIMOCUT_WHISPER_MODEL=large-v3-turbo
# PRIMOCUT_WHISPER_DEVICE=cuda
# PRIMOCUT_WHISPER_COMPUTE_TYPE=float16
# PRIMOCUT_WHISPER_COMPUTE_FALLBACKS=float16,int8_float16,int8

# --- Resilience / fallbacks (optional) ---
# PRIMOCUT_RETRY_ATTEMPTS=3
# PRIMOCUT_RETRY_BASE_DELAY=1.0
# PRIMOCUT_RETRY_MAX_DELAY=30.0
# PRIMOCUT_YTDLP_PLAYER_CLIENTS=android,web

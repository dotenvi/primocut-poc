# Copy to .env and fill in the key for the provider you will use.
# The `primocut doctor` command validates the key of the selected provider.

# Analysis provider: anthropic (default), openai or openrouter
# PRIMOCUT_LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
# PRIMOCUT_ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI ---
OPENAI_API_KEY=
# PRIMOCUT_OPENAI_MODEL=gpt-4o

# --- OpenRouter (OpenAI-compatible; access many models with 1 key) ---
OPENROUTER_API_KEY=
# PRIMOCUT_OPENROUTER_MODEL=openai/gpt-4o-mini
# PRIMOCUT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Competitor modeling (Phase 2): YouTube Data API v3 (public data only) ---
# Required for projects/competitor commands. Free tier: 10,000 units/day.
PRIMOCUT_YOUTUBE_API_KEY=
# PRIMOCUT_YOUTUBE_SHORT_MAX_SECONDS=180    # is_short heuristic: YouTube's Shorts ceiling
# PRIMOCUT_YOUTUBE_BACKFILL_LIMIT=120
# PRIMOCUT_YOUTUBE_RECENT_DAYS=7            # a video is "recent" (6h pass) for this many days
# PRIMOCUT_YOUTUBE_UPLOADS_SCAN_LIMIT=15    # top-of-uploads window for new-video detection
# PRIMOCUT_YOUTUBE_COMMENT_PAGES=2          # pages of top comments collected per outlier (1 unit/page of 100)
# Snapshot cron schedules (daily hour offset from the 6h grid to avoid same-tick runs):
# PRIMOCUT_SNAPSHOT_DAILY_CRON=0 3 * * *
# PRIMOCUT_SNAPSHOT_RECENT_CRON=0 */6 * * *

# --- Competitor modeling (Phase 2): metrics engine (computed on read) ---
# Outlier score = latest views / channel median baseline (per format). Baseline
# window = the smaller of "last N videos" and "last D days"; min sample before a
# score is emitted; a video younger than the provisional cutoff is flagged.
# PRIMOCUT_OUTLIER_WINDOW_VIDEOS=50
# PRIMOCUT_OUTLIER_WINDOW_DAYS=180
# PRIMOCUT_OUTLIER_MIN_SAMPLE=10
# PRIMOCUT_OUTLIER_PROVISIONAL_DAYS=7
# PRIMOCUT_OUTLIER_BRACKETS=3,6,10          # ascending multiplier tiers
# PRIMOCUT_VPH_CURRENT_WINDOW_HOURS=24      # "current" VPH = delta over this window
# Resurgence: old video whose current VPH >= k× its recent trailing-average VPH.
# PRIMOCUT_RESURGENCE_MIN_AGE_DAYS=30
# PRIMOCUT_RESURGENCE_K=3.0
# PRIMOCUT_RESURGENCE_BASELINE_DAYS=7
# PRIMOCUT_RESURGENCE_MIN_VPH=1.0
# PRIMOCUT_PACKAGING_IMPACT_WINDOW_DAYS=7   # mean VPH this many days before/after a change
# Per-project pattern distributions: guard + the bracket that counts as an outlier.
# PRIMOCUT_PATTERN_MIN_OCCURRENCE=15
# PRIMOCUT_PATTERN_OUTLIER_BRACKET=3.0

# --- Phase 2: AI packaging enrichment (opt-in — costs an LLM call) ---
# Empty (the default) means "use the model configured for the selected provider".
# Set one to spend less on a pass. A model id is provider-specific, so an override
# is only valid for the provider in use; the vision model must accept images.
# PRIMOCUT_ENRICH_TITLE_MODEL=claude-haiku-4-5
# PRIMOCUT_ENRICH_VISION_MODEL=claude-sonnet-5
# PRIMOCUT_ENRICH_COMMENTS_MODEL=claude-haiku-4-5

# --- Phase 3: clip rendering (FFmpeg/NVENC) ---
# Clips are deliverables under <clips_dir>/<video_id>/<cut_id>/NNN-slug.mp4,
# never auto-cleaned. Only the SECTION around an item is downloaded (ephemeral),
# with a keyframe-safety margin; the fine cut re-encodes to the exact boundaries.
# PRIMOCUT_CLIPS_DIR=clips
# PRIMOCUT_RENDER_SECTION_MARGIN_S=15.0
# Default encoder: nvenc (falls back to libx264 on failure) | libx264. `-c copy`
# is opt-in per render (the request's fast_copy), documented as keyframe-imprecise.
# PRIMOCUT_RENDER_ENCODER=nvenc
# PRIMOCUT_RENDER_NVENC_CQ=19
# PRIMOCUT_RENDER_X264_CRF=18
# PRIMOCUT_RENDER_AUDIO_BITRATE=192k

# --- Phase 3: cut export (deliverable bundle) ---
# Base dir for the export packages (kept separate from clips; never auto-swept).
# PRIMOCUT_EXPORTS_DIR=exports
# Target height for --upscale-1440p (only the master is re-encoded).
# PRIMOCUT_EXPORT_UPSCALE_HEIGHT=1440

# --- Phase 3: surgical WhisperX boundary alignment (SEPARATE venv) ---
# WhisperX/pyannote/torch conflict with the validated worker venv, so alignment
# runs in its own venv and the render worker shells out to its interpreter. Leave
# unset to disable — the render then keeps the item's original [start, end]
# (refinement is an improvement, never a blocker). Setup:
#   python3 -m venv .venv-align
#   /usr/bin/python3 -m pip --python .venv-align/bin/python install -e '.[align]'
# PRIMOCUT_ALIGN_PYTHON=.venv-align/bin/python
# PRIMOCUT_ALIGN_TOLERANCE_S=3.0     # move a boundary only within this window (<= section margin)
# PRIMOCUT_ALIGN_TIMEOUT_S=60.0      # subprocess cap; exceeding it → silent fallback
# PRIMOCUT_ALIGN_MODEL=              # optional wav2vec2 PT-BR override; empty → whisperx default

# --- Phase 3: AI packaging of a cut (opt-in — costs LLM; frame extraction is free) ---
# Per-clip titles/thumbnail-brief + candidate-frame ranking, driven by the niche's
# Phase 2 patterns. Everything is opt-in and paid for once per clip.
# PRIMOCUT_PACKAGING_TITLES_K=5             # default candidate titles per clip (selectable in the UI)
# PRIMOCUT_PACKAGING_FRAMES_PER_CLIP=3      # default candidate frames per clip (selectable in the UI)
# PRIMOCUT_PACKAGING_SCENE_THRESHOLD=0.30   # FFmpeg scene-detection threshold for frame extraction
# PRIMOCUT_PACKAGING_CONVENTION_FLOOR=0.85  # a boolean this common across the niche is a convention (not a differential)
# PRIMOCUT_PACKAGING_CARRIES_VALUE_MIN_VIDEOS=3   # a carries-value pattern needs >= this many outlier videos
# PRIMOCUT_PACKAGING_CARRIES_VALUE_MIN_LIFT=1.5   # ...and at least this lift over the control
# PRIMOCUT_PACKAGING_EXAMPLES=6             # how many real outlier examples the prompt cites
# PRIMOCUT_PACKAGING_FORMAT=long            # which niche format's patterns drive packaging (long|short)
# PRIMOCUT_PACKAGING_TITLES_MODEL=          # optional per-pass model overrides (empty → provider default;
# PRIMOCUT_PACKAGING_BRIEF_MODEL=           #   the frame-ranking pass needs a VISION-capable model)
# PRIMOCUT_PACKAGING_FRAME_RANK_MODEL=
# PRIMOCUT_PACKAGING_AUDIENCE_MODEL=

# --- Transcription (optional, have defaults in config.py) ---
# PRIMOCUT_WHISPER_MODEL=large-v3-turbo
# PRIMOCUT_WHISPER_DEVICE=cuda
# PRIMOCUT_WHISPER_COMPUTE_TYPE=float16
# PRIMOCUT_WHISPER_COMPUTE_FALLBACKS=float16,int8_float16,int8

# --- Resilience / fallbacks (optional) ---
# PRIMOCUT_RETRY_ATTEMPTS=3
# PRIMOCUT_RETRY_BASE_DELAY=1.0
# PRIMOCUT_RETRY_MAX_DELAY=30.0
# PRIMOCUT_YTDLP_PLAYER_CLIENTS=android,web
